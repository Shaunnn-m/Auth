{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Application": {
    "BaseUrl": ""
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "PasswordPolicy": {
    "MinimumLength": 8,
    "RequireUppercase": true,
    "RequireLowercase": true,
    "RequireDigit": true,
    "RequireSpecialCharacter": false
  },
  "Jwt": {
    "Issuer": "Authentication.Api",
    "Audience": "Authentication.Api",
    "ExpirationMinutes": 60
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "FromEmail": "no-reply@authentication.local",
    "FromName": "Authentication API",
    "Username": "",
    "Password": "",
    "UseSsl": false
  }
}
